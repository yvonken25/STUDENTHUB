# Copie ce fichier en ".env" (jamais versionné) et remplis les valeurs.

# Obtenues avec la commande : supabase status
SUPABASE_URL=http://127.0.0.1:54321
# Clé service_role : SECRÈTE, uniquement dans le backend (jamais frontend, jamais WordPress)
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000
# Origines autorisées pour le frontend, séparées par des virgules
CORS_ORIGIN=http://localhost:5173
